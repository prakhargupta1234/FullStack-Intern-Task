# Database Configuration
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
# Note: If your password contains special characters like '@', URL-encode it (e.g. '@' becomes '%40')
# or use the individual DB_* variables below:
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/appointment_board

# Optional granular credentials:
DB_USER=root
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appointment_board

# Application Settings
FRONTEND_URL=http://localhost:5173
PORT=8000
HOST=0.0.0.0
